{
  "modes": {
    "AURA": "Aura",
    "BANISH": "Banish",
    "SUMMON": "Summon",
    "BEAM": "Beam",
    "BURST": "Burst",
    "LINE": "Line",
    "FUSE": "Blast",
    "BLAST": "Blast",
    "SINGLE": "Single"
  },
  "lines": [
    {"keys": ["pierce"], "in_row": true, "text": "Pierce: {pierce}-cell-wide line"},
    {"keys": ["aoe_radius"], "text": "Blast radius {aoe_radius|cells}"},
    {"keys": ["fuse_seconds"], "text": "Fuse {fuse_seconds} s, thrown ahead"},
    {"keys": ["ignore_armor"], "text": "Ignores armor"},
    {"keys": ["sanity_scaling"], "text": "Up to x{sanity_scaling|plus1} at low sanity"},
    {"keys": ["reveal_fakes"], "text": "Reveals fakes"},
    {"keys": ["slow"], "text": "Slows enemies {slow|pct}%"},
    {"keys": ["damage_taken_multiplier"], "defaults": {"damage_taken_multiplier": 1},
     "text": "Foes take +{damage_taken_multiplier|pct_over1}% damage"},
    {"keys": ["casts_light"], "text": "Lights towers and foes"},
    {"keys": ["casts_shadow"], "text": "Shadows towers at night"},
    {"keys": ["crit_chance", "crit_multiplier"],
     "text": "{crit_chance|pct}% crit, x{crit_multiplier} damage"},
    {"keys": ["burst_targets"], "text": "Spreads fire over {burst_targets} foes"},
    {"keys": ["bleed_dps", "bleed_seconds"], "text": "Bleed {bleed_dps}/s for {bleed_seconds} s"},
    {"keys": ["pull_cells", "pull_max_hp", "pull_immune_seconds"],
     "text": "Pull {pull_cells}c, ≤{pull_max_hp} HP, {pull_immune_seconds}s"},
    {"keys": ["strip_armor"], "text": "Foes lose {strip_armor} armor"},
    {"keys": ["banish_cells", "banish_targets"], "defaults": {"banish_targets": 1},
     "text": [
       {"when": {"key": "banish_targets", "gt": 1},
        "text": "Banish {banish_targets} foes {banish_cells|cells}"},
       {"text": "Banish {banish_cells|cells} back"}
     ]},
    {"keys": ["banish_max_hp", "banish_immune_seconds"],
     "text": "Max {banish_max_hp} HP; immune {banish_immune_seconds} s"},
    {"keys": ["summon_max", "summon_lifetime"],
     "text": "Up to {summon_max} {summon_max|plural:unit:units}, {summon_lifetime} s each"},
    {"keys": ["summon_hp", "summon_dps"], "text": "Unit {summon_hp} HP, {summon_dps} DPS"},
    {"keys": ["summon_speed"], "text": "Unit speed {summon_speed} cells/s"},
    {"keys": ["summon_flying"], "in_row": true, "text": "Units fly, hold flyers"},
    {"keys": ["summon_contact"], "text": "Units hold foes within {summon_contact|cells}"},
    {"keys": ["summon_leash"], "text": "Units engage foes within {summon_leash|cells} of the circle"}
  ],
  "short": [
    {"key": "aoe_radius", "keep_case": true, "text": "r {aoe_radius}"},
    {"key": "fuse_seconds", "text": "fuse {fuse_seconds} s"},
    {"key": "ignore_armor", "text": "no armor"},
    {"key": "sanity_scaling", "text": "×{sanity_scaling|plus1} at 0 sanity"},
    {"key": "slow", "text": "slow {slow|pct}%"},
    {"key": "damage_taken_multiplier", "text": "+{damage_taken_multiplier|pct_over1}% taken"},
    {"key": "reveal_fakes", "text": "shows fakes"},
    {"key": "crit_chance", "defaults": {"crit_multiplier": 1},
     "text": "{crit_chance|pct}% crit ×{crit_multiplier}"},
    {"key": "burst_targets", "text": "{burst_targets} targets in turn"},
    {"key": "bleed_dps", "text": "bleed {bleed_dps}/s"},
    {"key": "pull_cells", "text": "pull {pull_cells}"},
    {"key": "strip_armor", "text": "−{strip_armor} armor"},
    {"key": "banish_cells", "text": "back {banish_cells|cells}"},
    {"key": "banish_targets", "when": {"key": "banish_targets", "gt": 1},
     "text": "{banish_targets} foes"},
    {"key": "banish_max_hp", "text": "≤{banish_max_hp} HP"},
    {"key": "summon_max", "text": "{summon_max} {summon_max|plural:unit:units}, {summon_hp} HP"},
    {"key": "casts_light", "text": "lights"},
    {"key": "casts_shadow", "text": "shadows"}
  ],
  "tips": [
    {"key": "casts_shadow",
     "text": "Shadow: at night, other towers in this tower's range\nare shadowed (a light on them cancels it).\nOccult in shadow: ×{shadow_occult_power_mult} power.\nMundane in shadow: +{shadow_mundane_fire_interval_mult|pct_over1}% fire interval, +{shadow_mundane_miss_chance_add|pct}% misses."}
  ]
}
